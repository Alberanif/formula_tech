{
  "name": "formula-tech",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/dev.ts",
    "dev:web": "vite --host 0.0.0.0",
    "db:migrate": "node scripts/migrate.mjs",
    "teacher:create": "node scripts/create-teacher.mjs",
    "db:cleanup": "node --import tsx scripts/cleanup.mjs",
    "load": "node scripts/load.mjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --import tsx --test tests/integration.test.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "vite": "^6.3.0"
  }
}
